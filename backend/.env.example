# ── AI Provider (choose one) ──────────────────────────────────────────────────
# Together AI (default)
TOGETHER_API_KEY=your_together_api_key_here

# RunPod serverless (overrides Together AI when both RUNPOD_* vars are set)
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# ── Model settings ────────────────────────────────────────────────────────────
MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
GENERATION_STEPS=30
GUIDANCE_SCALE=7.5

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
PORT=8000
