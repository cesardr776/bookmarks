# ── AI Provider ───────────────────────────────────────────────────────────────
# Set explicitly, or leave blank for auto-detection.
# Auto-detection priority:  runpod > huggingface > together
# Valid values: huggingface | local | runpod | together
# AI_PROVIDER=huggingface

# ── Option A: Hugging Face Inference API (cloud, no GPU required) ─────────────
# Real img2img with mrfakename/Z-Image-Turbo via HF Inference API.
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
# HF_MODEL_ID=mrfakename/Z-Image-Turbo   # default

# ── Option B: Local diffusers (GPU required) ──────────────────────────────────
# Real img2img running in-process. Requires: pip install -r requirements-gpu.txt
# AI_PROVIDER=local
# LOCAL_MODEL_ID=mrfakename/Z-Image-Turbo   # default
# DEVICE=cuda                               # cuda | mps | cpu
# TORCH_DTYPE=float16                       # float16 | bfloat16 | float32

# ── RunPod serverless (legacy) ────────────────────────────────────────────────
# RUNPOD_ENDPOINT_ID=abc123xyz
# RUNPOD_API_KEY=your_runpod_key_here

# ── Together AI text-to-image (legacy, NOT real img2img) ─────────────────────
# TOGETHER_API_KEY=your_together_api_key_here

# ── Model (used by RunPod and Together AI only) ───────────────────────────────
MODEL_ID=black-forest-labs/FLUX.1-schnell

# ── Generation parameters ─────────────────────────────────────────────────────
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
GENERATION_STEPS=4
GUIDANCE_SCALE=0.0      # SDXL Turbo: 0.0 — SD 1.5: 7.5
MODEL_STRENGTH=0.6      # img2img strength: 0=no change, 1=ignore input photo

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=storage
MAX_STORED_IMAGES=1000

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
PORT=8000
DEBUG=false
