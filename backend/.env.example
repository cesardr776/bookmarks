# ── AI Provider ───────────────────────────────────────────────────────────────
# Together AI (default) — get your key at https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_api_key_here

# RunPod (overrides Together AI when both vars are set)
# RUNPOD_ENDPOINT_ID=abc123xyz
# RUNPOD_API_KEY=your_runpod_key_here

# ── Model ─────────────────────────────────────────────────────────────────────
# Z-Image-Turbo on Together AI:
#   MODEL_ID=<z-image-turbo-model-id>
# Default (free, fast):
MODEL_ID=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
GENERATION_STEPS=4
GUIDANCE_SCALE=3.5

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DIR=storage
MAX_STORED_IMAGES=1000

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
PORT=8000
DEBUG=false
